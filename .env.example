# Copy this file to .env and fill in real values. Never commit the real .env file.

# Portal login credentials
APP_USERNAME=admin
APP_PASSWORD=change-me

# --- PMCP live editor (tools/coaching-bundle-export/) --------------------------
# Used by pmcp_login.py / export_coaching.sh to get past the login screen.
# USERNAME + PASSWORD are always auto-filled when set. TOTP_SECRET is optional:
# with it, the 6-digit 2FA code is generated too; without it, user+password are
# still filled and the script waits ~2 min for you to type the code by hand.
# TOTP_SECRET is the base32 seed shown when setting up the authenticator
# (spaces are fine).
PMCP_USERNAME=
PMCP_PASSWORD=
PMCP_TOTP_SECRET=
PMCP_LOGIN_URL=https://cp22.pathmate.cloud/PMCP/admin

# --- PCMS / CoachStudio Designer (tools/start_pcms.sh) --------------------------
# Same idea as the PMCP block above, for the CoachStudio Designer portal at
# my.pathmate.app. TOTP_SECRET is optional: if unset, the login form's own
# "0" (not-configured) convention is tried first, falling back to a ~2 min
# wait for you to type the real 2FA code if the account does have one set up.
PCMS_USERNAME=
PCMS_PASSWORD=
PCMS_TOTP_SECRET=
PCMS_LOGIN_URL=https://my.pathmate.app/pcms-alex/login

# Flask session signing key - generate with: python -c "import secrets; print(secrets.token_hex(32))"
APP_SECRET_KEY=change-me-too

# Where uploaded coachings and patient models are persisted on disk
DATA_DIR=data

# Port the app listens on when run directly (gunicorn/systemd override this in production)
PORT=8000

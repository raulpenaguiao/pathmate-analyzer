[Unit]
Description=Pathmate Analyzer web portal
After=network.target

[Service]
Type=simple
User=__RUN_USER__
WorkingDirectory=__APP_DIR__
EnvironmentFile=__APP_DIR__/.env
ExecStart=__VENV_DIR__/bin/gunicorn --workers 1 --bind 127.0.0.1:__PORT__ wsgi:app
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
